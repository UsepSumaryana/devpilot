{
  "name": "devpilot",
  "version": "0.2.0",
  "private": true,
  "description": "Run and monitor local dev services (any runtime) from Claude Code, a web dashboard and a Claude desktop panel.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "devpilot": "plugins/devpilot/dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundary": "node scripts/check-boundary.mjs",
    "devpilot": "node plugins/devpilot/dist/cli.js",
    "test:panel": "claude plugin test plugins/devpilot-panel",
    "validate": "claude plugin validate . && claude plugin validate plugins/devpilot && claude plugin validate plugins/devpilot-panel",
    "check": "npm run typecheck && npm run check:boundary && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "preact": "^11.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
